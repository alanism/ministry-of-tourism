{
  "hosting": {
    "target": "mot",
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "npm --prefix apps/web run build"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/connectors/muse/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/muse/images/status",
        "function": {
          "functionId": "motFundedImages",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/muse/discovery-status",
        "function": {
          "functionId": "motPublicDiscovery",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/muse/discover",
        "function": {
          "functionId": "motPublicDiscovery",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "backend/discovery",
      "codebase": "mot-discovery",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env*",
        ".secret*",
        "client/**",
        "src/**",
        "tsconfig.json",
        "build.mjs"
      ],
      "predeploy": [
        "npm --prefix backend/discovery run typecheck",
        "npm --prefix backend/discovery run build"
      ]
    },
    {
      "source": "backend/images",
      "codebase": "mot-images",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env*",
        ".secret*",
        "src/**",
        "tsconfig.json",
        "build.mjs"
      ],
      "predeploy": [
        "npm --prefix backend/images run typecheck",
        "npm --prefix backend/images run build"
      ]
    }
  ],
  "firestore": [
    {
      "database": "mot-discovery-usage",
      "location": "us-central1",
      "rules": "backend/discovery/firestore.rules",
      "indexes": "backend/discovery/firestore.indexes.json"
    }
  ]
}
