{
  "name": "writers-board",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "vitest run && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/bridge --noEmit && tsc -p packages/mot-server --noEmit && tsc -p apps/web --noEmit",
    "bridge": "node packages/bridge/src/cli.ts",
    "lenses:sync": "node scripts/sync-lenses.ts",
    "lenses:build": "node scripts/build-lenses.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
